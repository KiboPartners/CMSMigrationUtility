# =============================================================================
# Consolidated configuration for the Kibo CMS migration tool.
#
# Copy to `.env` at the repo root. The CLI, web UI, and all artifact engines
# read this single file (resolved by walking up to the repo root).
# =============================================================================

# --- Source environment (export / migrate) -----------------------------------
SOURCE_ADMIN_GQL_URL=https://cms-api.usc1.gcp.kibocommerce.com/graphql
# Manage API — entry CRUD + content-model management (cms-entries)
SOURCE_MANAGE_URL=https://cms-api.usc1.gcp.kibocommerce.com/cms/manage/en-US
SOURCE_API_KEY=your-source-api-key
SOURCE_TENANT=XXXXXX
SOURCE_CDN_DOMAIN=https://cms-api.usc1.gcp.kibocommerce.com

# --- Target environment (import / migrate / purge) ---------------------------
TARGET_ADMIN_GQL_URL=https://cms-api.usc1.gcp.kibocommerce.com/graphql
TARGET_MANAGE_URL=https://cms-api.usc1.gcp.kibocommerce.com/cms/manage/en-US
TARGET_API_KEY=your-target-api-key
TARGET_TENANT=XXXXXXXX
TARGET_CDN_DOMAIN=https://cms-api.usc1.gcp.kibocommerce.com

# --- Shared ------------------------------------------------------------------
LOCALE=en-US
CONCURRENCY=5                   # parallel writes on import
EXPORT_CONCURRENCY=6            # parallel models on export + catalog (falls back to CONCURRENCY)
DRY_RUN=false                   # default dry-run for CLIs that honor the flag
RATE_LIMIT_DELAY_MS=0           # floor for adaptive GraphQL throttle (ms)
DEBUG=false                     # true = log every GraphQL op / vars / timing
# AS_DRAFT=true                 # leave entries/pages as draft on import/migrate (default on; set false to publish when source was published)

# Optional filters (blank = no filter)
# MODELS=PromoBanner,Article    # cms-entries: only these model names
SITE_ID_FILTER=                 # cms-entries: only entries with this siteId
TAGS_FILTER=                    # file-manager: only files with these tags (comma-sep)

# Content models are fetched live from the source Manage API by default.
# Optional offline override (Content Models → ⋮ → Export):
# SCHEMA_FILE=./cms-schema.json

# cms-entries: importStructure batching (gateway ~30s — keep small if you see 504s)
STRUCTURE_CHUNK_SIZE=1          # models per importStructure call (default 1)
STRUCTURE_TIMEOUT_MS=35000      # abort a hung structure call (default 35000)

# page-builder / file-manager
INCLUDE_UNPUBLISHED=true        # page-builder export: include unpublished pages
SKIP_EXISTING=true              # file-manager import: skip files already on target

# --- file-manager binaries ---------------------------------------------------
# Streaming source CDN → target S3 is the default. These bucket names are only
# used when writing aws s3 cp lines into s3-copy-manifest.txt (size-gate skips /
# --manifest-only).
MAX_FILE_SIZE_MB=               # blank/0 = no limit; e.g. 100 skips files over 100 MB
SOURCE_S3_BUCKET=source-bucket
TARGET_S3_BUCKET=target-bucket
SOURCE_S3_PREFIX=files/
