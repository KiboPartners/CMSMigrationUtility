{
  "name": "kibo-cms-clone-tool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p src/shared/tsconfig.json",
    "postinstall": "npm run build && node ./register-shared.js",
    "clean": "node -e \"require('fs').rmSync('src/shared/dist',{recursive:true,force:true}); require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui-hydrate": "playwright test e2e/01-smoke.spec.ts e2e/19-hydrate-deps-ui.spec.ts e2e/20-export-import-hydrate-ui.spec.ts",
    "test:plan": "vitest run && playwright test e2e/01-smoke.spec.ts e2e/19-hydrate-deps-ui.spec.ts e2e/20-export-import-hydrate-ui.spec.ts",
    "test:perf": "ts-node -r ./register-shared.js scripts/perf-large-migrate-import.ts",
    "docs:ui-shots": "ts-node -r ./register-shared.js scripts/capture-ui-docs.ts",
    "serve": "ts-node -r ./register-shared.js index.ts serve",
    "export-all": "ts-node -r ./register-shared.js index.ts export-all",
    "import-all": "ts-node -r ./register-shared.js index.ts import-all",
    "cli": "ts-node -r ./register-shared.js index.ts"
  },
  "dependencies": {
    "@kibo-cms-clone-tool/shared": "file:src/shared",
    "adm-zip": "^0.5.18",
    "cli-progress": "^3.12.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "p-limit": "3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/adm-zip": "^0.5.8",
    "@types/cli-progress": "^3.11.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "vitest": "^4.1.8"
  }
}
